{
  "name": "openrouter",
  "version": "0.1.0",
  "display_name": "OpenRouter Cloud Backend",
  "description": "OpenRouter API backend for 500+ models via OpenAI Chat-Completions API",
  "author": "VTSTech",
  "license": "MIT",
  "type": "backend",
  "entrypoint": "__init__",
  "depends": [],
  "optional_depends": [],
  "config": {
    "env_prefix": "OPENROUTER",
    "defaults": {
      "OPENROUTER_API_KEY": "",
      "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
      "OPENROUTER_DEFAULT_MODEL": "anthropic/claude-3.5-sonnet",
      "OPENROUTER_FREE_ONLY": "false"
    }
  },
  "provides": {
    "backends": {
      "openrouter": "openrouter.OpenRouterBackend"
    },
    "cli_flags": {
      "--backend": ["openrouter"]
    }
  },
  "compatibility": {
    "agentnova": ">=0.5.0"
  }
}